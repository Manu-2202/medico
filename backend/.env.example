# Copy this file to .env and fill in real values. Never commit .env to git.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/medico_overseas

# Generate a long random string, e.g.: openssl rand -hex 32
JWT_SECRET=

# reCAPTCHA v2/v3 keys — get real ones from https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# SMTP (e.g. Gmail App Password — NOT your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_EMAIL=

SITE_URL=http://localhost:5000

# One-time admin bootstrap — used ONLY to create the very first admin account.
# After first login these are ignored; the account then lives (hashed) in MongoDB.
# Set a strong, unique password here, then remove/blank these two lines after first login.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# AI chatbot (optional — chatbot falls back to scripted responses if unset)
ANTHROPIC_API_KEY=
